# ── Claude-to-IM Bridge Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.

# Master switch
CLAUDE_TO_IM_ENABLED=true
CLAUDE_TO_IM_AUTO_START=true

# Default Claude model
CLAUDE_TO_IM_MODEL=claude-sonnet-4-20250514

# Default working directory for Claude Code sessions
CLAUDE_TO_IM_WORK_DIR=$HOME

# JSON store file path (optional, default: ~/.claude-to-im/store.json)
# CLAUDE_TO_IM_STORE_PATH=

# ── Telegram Configuration ─────────────────────────────────────────
# Get a bot token from https://t.me/BotFather
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of allowed Telegram user IDs (or chat IDs)
# Leave empty to use TELEGRAM_CHAT_ID as fallback
TELEGRAM_ALLOWED_USERS=

# ── Feishu (Lark) Configuration ────────────────────────────────────
# Create an app at https://open.feishu.cn/app
FEISHU_ENABLED=true
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here

# Domain: "feishu" (default, for Chinese users) or "lark" (for international)
FEISHU_DOMAIN=feishu

# Comma-separated list of allowed Feishu user IDs (optional)
FEISHU_ALLOWED_USERS=
